# Micro Digital Twin — variabili d'ambiente (nessun segreto nel client)
# M0 non richiede variabili: persistenza locale e Open-Meteo senza chiave.

# M1 — Supabase (solo URL e chiave PUBBLICA nel client; secret/service key restano nelle Edge Functions)
VITE_SUPABASE_URL=
# publishable key (sb_publishable_…): ha la precedenza; la vecchia anon key resta come alternativa
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# F31 — Previsioni: URL del proxy autenticato verso services/forecasting (vuoto = "Motore Timestral non configurato")
VITE_FORECAST_URL=

# M1 — Edge Functions (lato server, MAI con prefisso VITE_)
SUPABASE_SERVICE_ROLE_KEY=
GEOCODER_USER_AGENT=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# F04 — Acquisizione meteo: segreto della Edge Function open-meteo-ingest e del job pg_cron (solo lato server e Vault)
OPEN_METEO_CRON_SECRET=
# origine ammessa per le chiamate dal browser (es. https://manocchio91.github.io)
ALLOWED_ORIGIN=

# F31 — Servizio di previsione (solo lato server; impostare in un file locale escluso da Git)
FORECAST_SERVICE_TOKEN=
FORECAST_MODELS=mistralai/Timestral-5M
